# 服务配置
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qiying_admin
DB_USER=root
DB_PASSWORD=root
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=qiying_admin_secret_key_2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov,avi,pdf,doc,docx,xls,xlsx

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
